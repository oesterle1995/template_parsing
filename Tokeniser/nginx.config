#http{
    #keepalive_timeout 65;  # Contexte protocole HTTP 

    server {  # Premier serveur virtuel
        listen 127.0.0.1:8080; \    
        server_name localhost;

        root /home/user/webserv/www;
        index index.html index.php;

        client_max_body_size 2000000; # Limite à ~2 Mo

        error_page 404 /error/404.html;
        error_page 405 /error/405.html;
        error_page 500 502 503 504 /error/50x.html;

        # Configuration pour /Documents
        location /Documents {
            methods GET;
            autoindex off;
            return 404;
        }

        # Configuration pour /admin (Corrigé avec le point-virgule manquant)
        location "/admin{"
            return 403;
            }
        }

    server 
    {
        listen 127.0.0.1:8080;
        server_name blog.google.com;

        root /home/user/webserv/www;
        index index.html index.php;

        client_max_body_size 2000000; # Limite à ~2 Mo

        error_page 404 /error/404.html;
        error_page 405 /error/405.html;
        error_page 500 502 503 504 /error/50x.html; \

        # Configuration pour la racine /
        location / 
        {
            root /home/user/;
            methods GET POST;
            autoindex off;
        }

        # Configuration pour un dossier d'images avec listing activé
        location /images 
        {
            "root /home/user/webserv/;"
            methods GET;
            autoindex on;
        }

        # Configuration pour l'upload de fichiers
        location /upload 
        {
            methods POST;
            upload_store /home/user/webserv/www/uploads;
        }

        # Configuration pour gérer le CGI PHP
        location /home/user/webserv/www/
        {
            cgi_extension .php /usr/bin/php-cgi; \\r
            cgi_extension .py /usr/bin/py-cgi;
        }

        # Exemple de redirection HTTP
        location /old-route
        {
            return 301 /new-route;
        }
    }